# ==============================================================================
# 🎓 SubhChandra Education - Environment Example (.env.example)
# ==============================================================================
# Copy this file to .env.local and fill in your actual credentials.

# ------------------------------------------------------------------------------
# 🌐 1. Public App & Brand Configuration (Client-side accessible)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="SubhChandra Education"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api/v1

# Contact & Admission Helplines
NEXT_PUBLIC_PHONE_PRIMARY="+91 88008 85175"
NEXT_PUBLIC_PHONE_SECONDARY="+91 91559 99988"
NEXT_PUBLIC_WHATSAPP_NUMBER=918800885175
NEXT_PUBLIC_CONTACT_EMAIL=admissions@subhchandra.com
NEXT_PUBLIC_OFFICE_ADDRESS="Head Office: E-211, Road No 2, Backside of Ruban Hospital, Patliputra Colony, Patna, Bihar - 800013"

# Analytics & Tracking (Optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ------------------------------------------------------------------------------
# 🗄️ 2. Database Connection (Server-side only)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/subhchandra

# ------------------------------------------------------------------------------
# 🔐 3. Authentication & Security Secrets (Server-side only)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=7d
REVALIDATE_SECRET=your_revalidate_secret_key_here
INTERNAL_API_KEY=your_internal_api_key_here

# ------------------------------------------------------------------------------
# 📧 4. Email & Notification Services (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME="SubhChandra Education Admissions"
SMTP_FROM_EMAIL=admissions@subhchandra.com
ADMIN_NOTIFY_EMAIL=admissions@subhchandra.com

# ------------------------------------------------------------------------------
# ☁️ 5. Cloud Storage (Optional)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# ⚙️ 6. Node Environment Flags
# ------------------------------------------------------------------------------
NODE_ENV=development
